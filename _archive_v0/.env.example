# ─────────────────────────────────────────────────────────────
# VIRALYA — variables d'environnement (copier vers .env)
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
# Clé pour protéger les endpoints /admin (ex: déclencher plan_day, run worker once)
ADMIN_API_KEY=change-me-long-random-string

# --- Supabase (région EU) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Connexion Postgres directe (pour migrations / worker si besoin)
SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres
# Bucket de stockage des assets générés
SUPABASE_STORAGE_BUCKET=avatar-assets

# --- IA texte (script, hooks, captions) ---
# LLM_PROVIDER = openai | anthropic
LLM_PROVIDER=anthropic
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# --- IA voix (ElevenLabs) ---
ELEVENLABS_API_KEY=your-elevenlabs-key

# --- IA vidéo talking-head (HeyGen = provider par défaut) ---
# VIDEO_PROVIDER = heygen | stub
VIDEO_PROVIDER=heygen
HEYGEN_API_KEY=your-heygen-key

# --- IA image (DALL-E via OpenAI par défaut) ---
# IMAGE_PROVIDER = openai | stub
IMAGE_PROVIDER=openai

# --- Paiement (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email marketing (Brevo) ---
BREVO_API_KEY=your-brevo-key
BREVO_WELCOME_LIST_ID=1
BREVO_SENDER_EMAIL=no-reply@tondomaine.com
BREVO_SENDER_NAME=VIRALYA

# --- Funnel / conformité ---
CONTACT_EMAIL=contact@tondomaine.com
# Pixels (optionnels — injectés dans les landing pages si renseignés)
META_PIXEL_ID=
GTAG_ID=

# --- Écosystème vivant ---
# Météo = Open-Meteo (gratuit, AUCUNE clé requise).
# Tendances/actus de niche (optionnel) : clé NewsAPI.org — sinon signal ignoré.
NEWS_API_KEY=

# --- Planification réseaux (Buffer par défaut) ---
# SCHEDULER_PROVIDER = buffer | publer | stub
SCHEDULER_PROVIDER=stub
BUFFER_ACCESS_TOKEN=your-buffer-token
PUBLER_API_KEY=your-publer-key
