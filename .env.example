# ─────────────────────────────────────────────────────────────
# VIRALYA V1 — variables d'environnement (copier vers .env)
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
ADMIN_API_KEY=change-me-long-random-string

# --- Supabase (région EU) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=avatar-assets

# --- IA texte (scripts, hooks, captions) ---
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- IA image (carrousels/stories) ---
IMAGE_PROVIDER=openai           # openai (gpt-image-1) | stub

# --- IA vidéo talking-head : défaut global (surchargeable par avatar) ---
VIDEO_PROVIDER=heygen           # heygen | argil | stub
HEYGEN_API_KEY=
ARGIL_API_KEY=

# --- Contexte vivant ---
# Météo = Open-Meteo (gratuit, aucune clé). Tendances (optionnel) = NewsAPI.
NEWS_API_KEY=

# --- Worker ---
RUN_WORKER_INLINE=true          # true = worker dans le process API (dev)

# --- Comptes utilisateurs (auth Supabase) ---
# SUPABASE_ANON_KEY est requise pour login/signup (déjà plus haut).
# ALLOW_SIGNUP=false pour fermer les inscriptions publiques.
ALLOW_SIGNUP=true
# Compte admin créé automatiquement au démarrage s'il n'existe pas (optionnel) :
ADMIN_EMAIL=
ADMIN_PASSWORD=
