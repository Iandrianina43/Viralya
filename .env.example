# ─────────────────────────────────────────────────────────────
# VIRALYA V1 — variables d'environnement (copier vers .env)
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
ADMIN_API_KEY=change-me-long-random-string

# --- Supabase (région EU) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=avatar-assets

# --- IA texte (scripts, hooks, captions) ---
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- IA image (portraits, character sheets, carrousels/stories) ---
IMAGE_PROVIDER=piapi            # piapi (Seedream 5 Pro / Nano Banana 2, défaut) | openai (GPT Image 2, option) | stub
IMAGE_MODEL=seedream-5-pro      # seedream-5-pro | nano-banana-2 | seedream-5-lite | nano-banana-pro
PYTHON_BIN=python               # pour le contrôle qualité des visages (tools/qc, OpenCV)

# --- IA vidéo : Seedance 2.0 via PiAPI (moteur principal) ---
PIAPI_API_KEY=

# --- Voix (choix de la voix + échantillons de timbre pour Seedance) ---
ELEVENLABS_API_KEY=

# --- Contexte vivant ---
# Météo = Open-Meteo (gratuit, aucune clé). Tendances (optionnel) = NewsAPI.
NEWS_API_KEY=

# --- Worker ---
RUN_WORKER_INLINE=true          # true = worker dans le process API (dev)

# --- Comptes utilisateurs (auth Supabase) ---
# SUPABASE_ANON_KEY est requise pour login/signup (déjà plus haut).
# ALLOW_SIGNUP=false pour fermer les inscriptions publiques.
ALLOW_SIGNUP=true
# Compte admin créé automatiquement au démarrage s'il n'existe pas (optionnel) :
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Contenu quotidien automatique (pg_cron → plan_day) ---
DAILY_PLAN_ENABLED=false        # false = les plan_day du cron sont ignorés (le bouton « Contenu du jour » reste actif)
