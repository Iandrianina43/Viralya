# ─────────────────────────────────────────────────────────────
# VIRALYA V1 — variables d'environnement (copier vers .env)
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
ADMIN_API_KEY=change-me-long-random-string

# --- Supabase (région EU) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=avatar-assets

# --- IA texte (scripts, hooks, captions) ---
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- IA image (portraits, character sheets, carrousels/stories) ---
IMAGE_PROVIDER=piapi            # piapi (Seedream 5 Pro / Nano Banana 2, défaut) | openai (GPT Image 2, option) | stub
IMAGE_MODEL=seedream-5-pro      # seedream-5-pro | nano-banana-2 | seedream-5-lite | nano-banana-pro
PYTHON_BIN=python               # pour le contrôle qualité des visages (tools/qc, OpenCV)

# --- IA vidéo : Seedance 2.0 via PiAPI (moteur principal) ---
PIAPI_API_KEY=

# --- Voix (choix de la voix + échantillons de timbre pour Seedance) ---
ELEVENLABS_API_KEY=

# --- Contexte vivant ---
# Météo = Open-Meteo (gratuit, aucune clé). Tendances (optionnel) = NewsAPI.
NEWS_API_KEY=

# --- Worker ---
RUN_WORKER_INLINE=true          # true = worker dans le process API (dev)

# --- Comptes utilisateurs (auth Supabase) ---
# SUPABASE_ANON_KEY est requise pour login/signup (déjà plus haut).
# ALLOW_SIGNUP=false pour fermer les inscriptions publiques.
ALLOW_SIGNUP=true
# Compte admin créé automatiquement au démarrage s'il n'existe pas (optionnel) :
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Contenu quotidien automatique (pg_cron → plan_day) ---
DAILY_PLAN_ENABLED=false        # false = les plan_day du cron sont ignorés (le bouton « Contenu du jour » reste actif)

# --- Facturation (Stripe, abonnements mensuels) ---
# Clé secrète + secret de signature du webhook (Workbench › Webhooks, endpoint https://<site>/api/billing/webhook,
# événements : checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Budget de génération (en $) des espaces sans forfait : vide = illimité, 0 = forfait obligatoire.
DEFAULT_MONTHLY_BUDGET_USD=

# --- E-mails (Resend) : contenu prêt, échec, alertes de budget ---
RESEND_API_KEY=
EMAIL_FROM=Viralya <no-reply@ton-domaine.fr>


# --- Publication réelle (Zernio, https://zernio.com) ---
# Clé API du tableau de bord Zernio (Settings › API keys). 2 comptes connectés gratuits, puis 6 $/compte/mois
# (3-10), 3 $ (11-100), 1 $ (101+). Sans clé : publication simulée sur le compte social interne.
ZERNIO_API_KEY=
# Secret choisi par toi (32+ caractères aléatoires). Le webhook https://<site>/api/social/zernio/webhook est
# enregistré automatiquement au démarrage de l'API et signé avec ce secret (X-Zernio-Signature).
ZERNIO_WEBHOOK_SECRET=
