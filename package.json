{
  "name": "viralya",
  "version": "1.0.0",
  "private": true,
  "description": "VIRALYA V1 — moteur d'influenceurs IA vivants (A: avatars, B: contenu, C: validation).",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @viralya/api dev",
    "dev:web": "pnpm --filter @viralya/web dev",
    "worker": "pnpm --filter @viralya/api worker",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": { "typescript": "^5.6.3" }
}
